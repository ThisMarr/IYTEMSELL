# Copy this file to .env and fill in your Billplz values.
BILLPLZ_SECRET_KEY=YOUR_BILLPLZ_SECRET_KEY
BILLPLZ_COLLECTION_ID=YOUR_COLLECTION_ID
BILLPLZ_X_SIGNATURE_KEY=YOUR_X_SIGNATURE_KEY

# Use your public HTTPS domain in production.
# For local testing, use a tunnel such as ngrok.
PUBLIC_BASE_URL=https://your-domain.example

# Set true for Billplz Sandbox testing.
BILLPLZ_SANDBOX=true
PORT=3000
